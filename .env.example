# Google Gemini API Key for AI Food Recognition
# Get your free API key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# MongoDB Atlas connection string
# Create a free cluster at: https://www.mongodb.com/atlas
# Then get your connection string from the Atlas dashboard
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/spideytracker?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/spideytracker?retryWrites=true&w=majority
